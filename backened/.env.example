# ========================================================
# Personalized Travel Itinerary Planner Environment Variables
# ========================================================

# AI Providers (Google Gemini or OpenAI)
# Get your free Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: OpenAI API Key (if you prefer OpenAI)
OPENAI_API_KEY=

# Supabase Configuration
# Get your project URL and anon key from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000

